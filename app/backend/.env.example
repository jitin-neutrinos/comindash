# Backend env template — copy values from the app-root .env.example.
# Everything here is optional at boot: missing AI Hub tokens drop the stage
# into deterministic stub mode; the app never crashes on them.
DATABASE_URL=postgresql+asyncpg://insights:insights_local@localhost:5433/insights
DISCOURSE_BASE_URL=https://community.neutrinos.com
DISCOURSE_API_KEY=
DISCOURSE_API_USERNAME=system
DISCOURSE_CATEGORY_ID=
AIHUB_BASE_URL=https://aihub-staging.neutrinos.com
AIHUB_TOKEN_NER=
AIHUB_TOKEN_PRIORITY=
AIHUB_TOKEN_SENTIMENT=
AIHUB_ASSISTANT_TOKEN=
AIHUB_NER_DEPLOYMENT_ID=
AIHUB_PRIORITY_DEPLOYMENT_ID=
AIHUB_SENTIMENT_DEPLOYMENT_ID=
AIHUB_ASSISTANT_ID=
AIHUB_KNOWLEDGE_SOURCE_IDS=
INGEST_TOKEN=change-me-local
SCHEDULER_ENABLED=true
INGEST_INTERVAL_MINUTES=60
ASSISTANT_CYCLE_HOUR=2

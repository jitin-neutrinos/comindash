# Backend env template — copy values from the app-root .env.example.
# Everything here is optional at boot: without a sidecar the analysis stages fall
# back to deterministic stubs, and the app never crashes on missing values.
DATABASE_URL=postgresql+asyncpg://insights:insights_local@localhost:5433/insights
DISCOURSE_BASE_URL=https://community.neutrinos.com
DISCOURSE_API_KEY=
DISCOURSE_API_USERNAME=system
DISCOURSE_CATEGORY_ID=

# Host-run inference sidecar (Laya priority/sentiment + GLiNER NER).
# Inside containers the default is http://172.22.0.1:8101.
ANALYSIS_SIDECAR_URL=

# Assistant cycle (z.ai GLM). Empty key => skip mode.
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4/chat/completions
GLM_MODEL=glm-5.3

INGEST_TOKEN=change-me-local
SCHEDULER_ENABLED=true
INGEST_INTERVAL_MINUTES=60
ASSISTANT_CYCLE_HOUR=2

{
  "$schema": "neutrinos-design-tokens/1.0",
  "meta": {
    "brand": "Neutrinos",
    "tagline": "Reinvent. Accelerated.",
    "source": "Neutrinos Brand Identity Guide",
    "version": "1.0.0"
  },
  "color": {
    "core": {
      "white": {
        "hex": "#FFFFFF",
        "rgb": [
          255,
          255,
          255
        ],
        "role": "dominant surface"
      },
      "neutrinosBlue": {
        "hex": "#0066FF",
        "rgb": [
          0,
          102,
          255
        ],
        "cmyk": [
          100,
          50,
          0,
          0
        ],
        "pms": "285 C",
        "role": "primary / dominant"
      },
      "mistGray": {
        "hex": "#F5F5F5",
        "rgb": [
          245,
          245,
          245
        ],
        "cmyk": [
          0,
          0,
          0,
          5
        ],
        "role": "light neutral surface"
      },
      "midnightBlue": {
        "hex": "#00053D",
        "rgb": [
          0,
          5,
          61
        ],
        "cmyk": [
          97,
          55,
          3,
          58
        ],
        "role": "deep / dark surface"
      },
      "black": {
        "hex": "#000000",
        "rgb": [
          0,
          0,
          0
        ],
        "cmyk": [
          0,
          0,
          0,
          100
        ],
        "role": "body copy text"
      }
    },
    "rules": [
      "White and Neutrinos Blue are dominant in every communication.",
      "Mist Gray and Midnight Blue support, but never out-weigh, the two dominant colors.",
      "Black is primarily for body copy on white/gray backgrounds.",
      "Accents add energy but never dominate. Use ONE accent with the core colors.",
      "Never combine two accent colors in the same layout - except within charts and graphs.",
      "Headlines appear only in Black, Neutrinos Blue, or White."
    ],
    "accentRetired": {
      "note": "Celeste/mint/salmon/iris accents removed from rendering 2026-09-28 (blue-only policy). Values live in the canonical neutrinos-brand-core skill tokens; nothing in this app renders them."
    }
  },
  "typography": {
    "primary": {
      "family": "Poppins",
      "source": "Google Fonts (Open Font License)",
      "weights": {
        "light": {
          "value": 300,
          "use": "body text"
        },
        "regular": {
          "value": 400,
          "use": "body substitute for web accessibility / very small sizes"
        },
        "medium": {
          "value": 500,
          "use": "headlines"
        },
        "semibold": {
          "value": 600,
          "use": "sub-headings"
        }
      },
      "case": "Always upper and lower case.",
      "italic": "Use italics only to emphasize text or for grammatical call-outs, not as a dominant design element."
    },
    "alternative": {
      "family": "Segoe UI",
      "use": "Microsoft / Windows applications and email signatures. System font on Windows - do not redistribute.",
      "weights": {
        "semibold": "headlines",
        "regular": "body"
      }
    },
    "headingColors": [
      "#000000",
      "#0066FF",
      "#FFFFFF"
    ],
    "scaleRem": {
      "display": 4.5,
      "h1": 3,
      "h2": 2.25,
      "h3": 1.5,
      "h4": 1.25,
      "body": 1,
      "small": 0.875,
      "caption": 0.75
    },
    "lineHeight": {
      "tight": 1.1,
      "heading": 1.2,
      "body": 1.6
    }
  },
  "logo": {
    "configurations": [
      "horizontal (primary)",
      "vertical (narrow layouts, social avatar)",
      "symbol (small / icon)"
    ],
    "clearspace": "Minimum 1/4 X on all sides, where X = width of the Neutrinos symbol.",
    "minSize": {
      "withTagline": "25 px (0.347 in) high",
      "withoutTagline": "10 px (0.1 in) high"
    },
    "colorVersions": [
      "full color on white",
      "full color on Mist Gray",
      "full color on Neutrinos Blue",
      "full color on Midnight Blue",
      "all black",
      "all white"
    ],
    "tagline": {
      "text": "Reinvent. Accelerated.",
      "font": "Poppins Medium, upper and lower case",
      "color": "same as logotype - never colored",
      "maxHeight": "<= 1/3 of the logotype height",
      "offset": ">= 1X horizontal, >= 1/2 X vertical"
    }
  },
  "spacingRem": {
    "1": 0.25,
    "2": 0.5,
    "3": 0.75,
    "4": 1,
    "6": 1.5,
    "8": 2,
    "12": 3,
    "16": 4,
    "24": 6,
    "32": 8
  },
  "radius": {
    "pill": "999px",
    "sm": "4px",
    "md": "8px"
  }
}

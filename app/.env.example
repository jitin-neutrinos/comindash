# Copy to .env and fill in. Everything server-side; never commit .env.
# The stack runs with NONE of these set: analysis falls back to deterministic
# stubs and ingestion runs in public/keyless mode. Set them to go live.

# --- Database ----------------------------------------------------------------
DB_PASSWORD=insights_local

# --- Discourse community (REQUIRED for real ingestion) ------------------------
DISCOURSE_BASE_URL=https://community.neutrinos.com
# Admin key from {DISCOURSE_BASE_URL}/admin/api/keys — scope read-only
DISCOURSE_API_KEY=
DISCOURSE_API_USERNAME=system
DISCOURSE_CATEGORY_ID=
# First pass (no cursor) is a full backfill and uses the larger cap. Capping it
# truncates forum history permanently — leave it high.
DISCOURSE_BACKFILL_MAX_PAGES=2000
DISCOURSE_MAX_PAGES=20

# --- Analysis models ----------------------------------------------------------
# Priority/sentiment (Laya) + NER (GLiNER) are served by the host-run inference
# sidecar (ml/pipeline/inference_server.py), socket-activated on the host and
# reached over Docker's host gateway. Inside containers the default is
# http://172.22.0.1:8101; on the host it is http://127.0.0.1:8101.
# Leave UNSET to use the built-in defaults, or point at a different host/port.
ANALYSIS_SIDECAR_URL=

# --- Assistant cycle (GLM / z.ai) ---------------------------------------------
# The nightly analyst cycle (insight briefs) calls z.ai GLM. Leave GLM_API_KEY
# empty to run in skip mode: the cycle is recorded as skipped and the rest of
# the pipeline is unaffected.
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4/chat/completions
# prod .env pins a stronger model; default is glm-5.3
GLM_MODEL=glm-5.3

# --- Insight ingest gate ------------------------------------------------------
# Token for POST /api/insights/ingest (X-Ingest-Token header). Only needed if an
# external connector pushes insights in; the nightly cycle pulls them instead.
# Generate: openssl rand -hex 32
INGEST_TOKEN=change-me-local

# --- Dashboard auth -----------------------------------------------------------
# Password-only login for the dashboard. Provide EITHER the plaintext (hashed
# in memory at boot; never stored) OR a pre-computed Argon2id hash to keep the
# plaintext off the host entirely. Generate a hash:
#   python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('your-password'))"
DASHBOARD_PASSWORD=
DASHBOARD_PASSWORD_HASH=
# HMAC key for session cookies (openssl rand -hex 32). Falls back to
# INGEST_TOKEN if empty so a default deployment is never signed with a constant.
DASHBOARD_SESSION_SECRET=
# Absolute session lifetime.
DASHBOARD_SESSION_TTL_HOURS=24
# Sign out after this many minutes of no activity (client-side, 60s warning
# first). The TTL above is the absolute cap regardless of activity.
DASHBOARD_IDLE_MINUTES=30

# --- Pipeline behavior --------------------------------------------------------
SCHEDULER_ENABLED=true
INGEST_INTERVAL_MINUTES=60
ASSISTANT_CYCLE_HOUR=2
# Posts analysed per stage per run. Keeps a single run bounded; the queue picks
# up the remainder on the next tick.
ANALYSIS_BATCH_SIZE=500

# --- Retention / housekeeping -------------------------------------------------
RUN_RETENTION_DAYS=90
JOB_DONE_RETENTION_DAYS=14
JOB_DEAD_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=180

# --- Alerts (ntfy) ------------------------------------------------------------
# Optional: push operational alerts (storage thresholds, dead jobs). Empty
# NTFY_TOKEN disables alerting.
NTFY_URL=http://172.22.0.1:8086/
NTFY_TOPIC=comindash-alerts
NTFY_TOKEN=
STORAGE_WARN_PCT=80
STORAGE_CRIT_PCT=92

# --- Observability ------------------------------------------------------------
LOKI_URL=http://loki:3100
PROMETHEUS_URL=http://prometheus:9090
LOG_LEVEL=INFO
# Directory for the rotating JSONL fallback sink. Unwritable => stdout only.
LOG_DIR=/app/logs

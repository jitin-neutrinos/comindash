# Copy to .env and fill in. Everything server-side; never commit .env.

# --- Database ---
DB_PASSWORD=insights_local

# --- Discourse community (REQUIRED for real ingestion) ---
DISCOURSE_BASE_URL=https://community.neutrinos.com
# Admin key from {DISCOURSE_BASE_URL}/admin/api/keys — scope read-only
DISCOURSE_API_KEY=
DISCOURSE_API_USERNAME=system
DISCOURSE_CATEGORY_ID=
# First pass (no cursor) is a full backfill and uses the larger cap. Capping it
# truncates forum history permanently — leave it high.
DISCOURSE_BACKFILL_MAX_PAGES=2000
DISCOURSE_MAX_PAGES=20

# --- AI Hub (Sandbox first) --------------------------------------------------
AIHUB_BASE_URL=https://aihub-staging.neutrinos.com

# THE ONLY REQUIRED AI HUB VALUES. Tokens page -> Sandbox -> Add.
# A token is scoped to one model AND one model version and already carries the
# deployment binding, so nothing else is needed to call it. Set expiry=Never for
# an unattended pipeline; the value is shown once, so copy it immediately.
AIHUB_TOKEN_NER=
AIHUB_TOKEN_PRIORITY=
AIHUB_TOKEN_SENTIMENT=
AIHUB_ASSISTANT_TOKEN=

# Optional, recorded on model_versions rows for traceability only — never sent
# in a request body.
AIHUB_NER_DEPLOYMENT_ID=
AIHUB_PRIORITY_DEPLOYMENT_ID=
AIHUB_SENTIMENT_DEPLOYMENT_ID=
AIHUB_ASSISTANT_ID=

# Leave EMPTY to auto-discover every knowledge source mapped to the assistant
# (assistant/knowledge/find-all). Set only to restrict to specific ones.
AIHUB_KNOWLEDGE_SOURCE_IDS=

# Leave EMPTY for a normal AI Hub text model, which takes {"text": "..."}.
# Set to the training CSV's text column name ONLY if the model was trained from
# a multi-column file, in which case it takes {"input": {"<column>": "..."}}.
# The exact shape is on each model's Integration page ("copy the cURL").
AIHUB_INPUT_FIELD=

# Parallel single-inference calls per stage. AI Hub has no bulk-text endpoint
# (batch is file/multi-step), so throughput comes from concurrency.
AIHUB_CONCURRENCY=4
AIHUB_TIMEOUT_MS=60000
AIHUB_MAX_RETRIES=3

# --- Insight ingest gate ------------------------------------------------------
# Token for POST /api/insights/ingest. Only needed if AI Hub can reach this
# backend over the network (it cannot while the stack is bound to localhost —
# the nightly cycle pulls insights instead). Generate: openssl rand -hex 32
INGEST_TOKEN=change-me-local

# --- Pipeline behavior --------------------------------------------------------
SCHEDULER_ENABLED=true
INGEST_INTERVAL_MINUTES=60
ASSISTANT_CYCLE_HOUR=2
# Posts analysed per stage per run. Keeps a single run bounded; the queue picks
# up the remainder on the next tick.
ANALYSIS_BATCH_SIZE=500
# Poll AI Hub for Review Hub verdicts on predictions we already stored.
REVIEW_POLL_ENABLED=true

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=INFO
# Directory for the rotating JSONL fallback sink. Unwritable => stdout only.
LOG_DIR=/app/logs
